<?xml version="1.0" encoding="utf-8"?>
<!--
    O backend roda em HTTP (sem HTTPS). O Android bloqueia HTTP por padrão, então a
    exceção é liberada SOMENTE para os endereços de desenvolvimento abaixo.
    Qualquer outro site continua exigindo HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.5.36.6</domain>
    </domain-config>
</network-security-config>
